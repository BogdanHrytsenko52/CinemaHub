{
  "info": {
    "name": "CinemaHub API",
    "description": "CRUD endpoints for the CinemaHub university project.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "genre_id",
      "value": "1"
    },
    {
      "key": "movie_id",
      "value": "1"
    },
    {
      "key": "hall_id",
      "value": "1"
    },
    {
      "key": "seat_id",
      "value": "1"
    },
    {
      "key": "session_id",
      "value": "1"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Genres",
      "item": [
        {
          "name": "List genres",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/genres/"
          }
        },
        {
          "name": "Create genre",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Drama\"}"
            },
            "url": "{{base_url}}/api/genres/"
          }
        },
        {
          "name": "Get genre",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/genres/{{genre_id}}/"
          }
        },
        {
          "name": "Update genre",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Comedy\"}"
            },
            "url": "{{base_url}}/api/genres/{{genre_id}}/"
          }
        },
        {
          "name": "Delete genre",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/api/genres/{{genre_id}}/"
          }
        }
      ]
    },
    {
      "name": "Movies",
      "item": [
        {
          "name": "List movies with filters",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/movies/?search=inter&genre_id={{genre_id}}&ordering=-rating"
          }
        },
        {
          "name": "Create movie",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"Interstellar\",\"description\":\"Space travel film.\",\"genre_id\":{{genre_id}},\"duration\":169,\"rating\":\"8.7\",\"age_rating\":\"12+\"}"
            },
            "url": "{{base_url}}/api/movies/"
          }
        },
        {
          "name": "Get movie",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/movies/{{movie_id}}/"
          }
        },
        {
          "name": "Update movie",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"rating\":\"8.8\"}"
            },
            "url": "{{base_url}}/api/movies/{{movie_id}}/"
          }
        },
        {
          "name": "Delete movie",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/api/movies/{{movie_id}}/"
          }
        }
      ]
    },
    {
      "name": "Halls",
      "item": [
        {
          "name": "List halls",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/halls/"
          }
        },
        {
          "name": "Create hall",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Hall 1\"}"
            },
            "url": "{{base_url}}/api/halls/"
          }
        },
        {
          "name": "Get hall",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/halls/{{hall_id}}/"
          }
        },
        {
          "name": "Update hall",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Large hall\"}"
            },
            "url": "{{base_url}}/api/halls/{{hall_id}}/"
          }
        },
        {
          "name": "Delete hall",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/api/halls/{{hall_id}}/"
          }
        },
        {
          "name": "List hall seats",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/halls/{{hall_id}}/seats/"
          }
        }
      ]
    },
    {
      "name": "Seats",
      "item": [
        {
          "name": "List seats",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/seats/"
          }
        },
        {
          "name": "Create seat",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"hall_id\":{{hall_id}},\"row\":1,\"number\":1}"
            },
            "url": "{{base_url}}/api/seats/"
          }
        },
        {
          "name": "Get seat",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/seats/{{seat_id}}/"
          }
        },
        {
          "name": "Update seat",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"number\":2}"
            },
            "url": "{{base_url}}/api/seats/{{seat_id}}/"
          }
        },
        {
          "name": "Delete seat",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/api/seats/{{seat_id}}/"
          }
        }
      ]
    },
    {
      "name": "Sessions",
      "item": [
        {
          "name": "List sessions with filters",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/sessions/?movie_id={{movie_id}}&date=2026-10-20"
          }
        },
        {
          "name": "Create session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"movie_id\":{{movie_id}},\"hall_id\":{{hall_id}},\"start_time\":\"2026-10-20T18:00:00Z\",\"price\":\"200.00\"}"
            },
            "url": "{{base_url}}/api/sessions/"
          }
        },
        {
          "name": "Get session",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/sessions/{{session_id}}/"
          }
        },
        {
          "name": "Update session",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"price\":\"250.00\"}"
            },
            "url": "{{base_url}}/api/sessions/{{session_id}}/"
          }
        },
        {
          "name": "Delete session",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/api/sessions/{{session_id}}/"
          }
        },
        {
          "name": "List session seats",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/sessions/{{session_id}}/seats/"
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"cinema_user\",\"email\":\"user@example.com\",\"password\":\"CinemaHub_2026!\",\"password_confirmation\":\"CinemaHub_2026!\"}"
            },
            "url": "{{base_url}}/api/auth/register/"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('access_token', data.access);",
                  "pm.collectionVariables.set('refresh_token', data.refresh);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"cinema_user\",\"password\":\"CinemaHub_2026!\"}"
            },
            "url": "{{base_url}}/api/auth/login/"
          }
        },
        {
          "name": "Refresh access token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"refresh\":\"{{refresh_token}}\"}"
            },
            "url": "{{base_url}}/api/auth/refresh/"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/api/auth/logout/"
          }
        },
        {
          "name": "My profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/api/users/me/"
          }
        }
      ]
    },
    {
      "name": "Error examples",
      "item": [
        {
          "name": "400 - invalid movie",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"Broken\",\"description\":\"Invalid duration\",\"genre_id\":{{genre_id}},\"duration\":0,\"rating\":\"8.0\",\"age_rating\":\"12+\"}"
            },
            "url": "{{base_url}}/api/movies/"
          },
          "response": [
            {
              "name": "400 Bad Request",
              "status": "Bad Request",
              "code": 400,
              "header": [],
              "body": "{\"error\":{\"code\":\"bad_request\",\"message\":\"Request data is invalid.\",\"details\":{\"duration\":[\"Ensure this value is greater than or equal to 1.\"]}}}"
            }
          ]
        },
        {
          "name": "404 - missing genre",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/genres/99999/"
          },
          "response": [
            {
              "name": "404 Not Found",
              "status": "Not Found",
              "code": 404,
              "header": [],
              "body": "{\"error\":{\"code\":\"not_found\",\"message\":\"The requested object does not exist.\",\"details\":{\"detail\":\"Not found.\"}}}"
            }
          ]
        },
        {
          "name": "409 - delete genre with movies",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/genres/{{genre_id}}/",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ]
          },
          "response": [
            {
              "name": "409 Conflict",
              "status": "Conflict",
              "code": 409,
              "header": [],
              "body": "{\"error\":{\"code\":\"conflict\",\"message\":\"Cannot delete this genre because related records exist.\",\"details\":{\"detail\":\"Cannot delete this genre because related records exist.\"}}}"
            }
          ]
        }
      ]
    }
  ]
}
